{
  "name": "@mfup/server",
  "version": "0.2.0",
  "description": "MFUP/2 upload server for Node — a universal (req, res) handler + WebSocket upgrade pluggable into any Node HTTP stack (express, vite, raw http). Resumable, interactive, atomic multi-file uploads.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mfup-server": "bin/mfup-server.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0isy/mfup.git",
    "directory": "packages/server"
  },
  "keywords": [
    "upload",
    "multi-file",
    "resumable",
    "websocket",
    "express",
    "vite",
    "middleware",
    "mfup"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "redis": ">=4.6.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mfup/client": "*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "redis": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
