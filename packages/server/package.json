{
  "name": "@mfup/server",
  "version": "3.0.0",
  "type": "module",
  "license": "MIT",
  "description": "MFUP/3 Node server with streamed multipart, durable receipts and interactive publication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README_ru.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "ws": "^8.18.0"
  },
  "bin": {
    "mfup-server": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0isy/mfup.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/n0isy/mfup#readme",
  "bugs": {
    "url": "https://github.com/n0isy/mfup/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
