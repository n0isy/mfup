{
  "name": "@mfup/client",
  "version": "0.2.1",
  "description": "MFUP/2 resumable multi-file upload client: folder drag-and-drop, streaming or batched transport, interactive conflict handling, reconnect/resume",
  "keywords": [
    "upload",
    "resumable",
    "multi-file",
    "drag-and-drop",
    "websocket",
    "mfup"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n0isy/mfup.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/n0isy/mfup#readme",
  "bugs": {
    "url": "https://github.com/n0isy/mfup/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
